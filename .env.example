NODE_ENV=development
PORT=5000
DB_HOST=localhost
DB_PORT=5432
DB_USER=withplus_admin
DB_PASSWORD=WithplusDB2024!
DB_NAME=withplus
JWT_SECRET=your-secret-key-here
JWT_EXPIRY=900
REFRESH_TOKEN_EXPIRY=604800

# 대표자 2단계 인증(원가/정산 열람용) SMS 발송 - 알리고(aligo) 연동
# https://smartsms.aligo.in 에서 발급. 설정하지 않으면 SMS 인증수단은 501로 비활성화되고
# TOTP(인증 앱)/이메일 인증수단은 계속 정상 동작한다.
SMS_PROVIDER=aligo
ALIGO_API_KEY=
ALIGO_USER_ID=
ALIGO_SENDER=
# true로 두면 알리고 테스트모드(testmode_yn=Y)로 호출 - 실제 문자는 발송되지 않고 API 응답만 확인 가능
ALIGO_TEST_MODE=false

# Play 스토어 앱(TWA) 연결 — /.well-known/assetlinks.json (docs/APP_STORE_GUIDE.md 참고). 비워 두면 빈 배열을 내려줌
TWA_PACKAGE_NAME=
# Play Console > 앱 무결성 > 앱 서명 키 인증서의 SHA-256 (여러 개면 쉼표로 구분)
TWA_SHA256_FINGERPRINTS=
